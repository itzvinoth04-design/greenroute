{
  "name": "greenroute-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "GreenRoute - Sustainable Transport Planner Monorepo",
  "scripts": {
    "vercel-build": "cd backend && npm install && npx prisma generate && npx prisma db push && npm run seed && cd ../frontend && npm install && npm run build",
